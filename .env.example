# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Optional. Without it the scraper falls back to the channel's public RSS feed,
# which exposes only the 15 most recent uploads. With it, the A/V club archive
# backfills the channel's entire history via the YouTube Data API v3.
#
# Create at https://console.cloud.google.com/apis/credentials
#   Application restrictions : None       (Actions runners have dynamic IPs)
#   API restrictions         : YouTube Data API v3 ONLY
YOUTUBE_API_KEY=

# Optional. Milliseconds between requests to CYO (default 600). Raise it if you
# are running repeated scrapes and want to be gentler on a small volunteer site.
# CYO_DELAY_MS=600
